APP_NAME=ShipFast
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shipfast
DB_USERNAME=root
DB_PASSWORD=

# Shared hosting friendly: keep these on the database so no Redis is needed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail ---
# Local dev: 'log' writes emails to storage/logs. On cPanel use your SMTP details.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@shipfast.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS (optional; logs instead of sending if unset) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Seeded super admin (php artisan db:seed) ---
ADMIN_EMAIL=admin@shipfast.local
ADMIN_PASSWORD=admin12345
